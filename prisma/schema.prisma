// Data model for both business divisions plus the shared admin panel.
//
// Prisma 7 notes: the generator is `prisma-client` (not `prisma-client-js`),
// the client is emitted into the repo at lib/generated/prisma, and the
// datasource URL comes from prisma.config.ts rather than being declared here.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Shared enums
// ---------------------------------------------------------------------------

enum Division {
  DISPOSAL
  REFURBISHED
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  EDITOR
  CUSTOMER
  STAFF
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ---------------------------------------------------------------------------
// Auth (Auth.js / NextAuth Prisma adapter shape + Enterprise Extensions)
// ---------------------------------------------------------------------------

model User {
  id            String     @id @default(cuid())
  firstName     String?
  lastName      String?
  name          String?
  email         String     @unique
  emailVerified DateTime?
  image         String?
  googleId      String?    @unique
  passwordHash  String?
  role          Role       @default(CUSTOMER)
  status        UserStatus @default(ACTIVE)
  phone         String?
  company       String?
  lastLoginAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  /// Marketing opt-in. Defaults to false: consent must be given, never assumed.
  marketingConsent   Boolean   @default(false)
  marketingConsentAt DateTime?
  /// Opaque token so an unsubscribe link works without signing in.
  unsubscribeToken   String?   @unique

  accounts                Account[]
  sessions                Session[]
  addresses               Address[]
  orders                  Order[]
  wishlistItems           WishlistItem[]
  recentlyViewed          RecentlyViewed[]
  posts                   Post[]
  auditLogs               AuditLog[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  exchangeRequests        ExchangeRequest[]
  exchangeActivities      ExchangeActivity[]

  @@index([role])
  @@index([status])
  @@index([email])
  @@index([marketingConsent])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([token])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([token])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  action    String
  status    String   @default("SUCCESS")
  ipAddress String?
  userAgent String?
  details   Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([email])
  @@index([action])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Media library + SEO (shared by both divisions)
// ---------------------------------------------------------------------------

enum MediaType {
  IMAGE
  DOCUMENT
  VIDEO
}

model MediaFolder {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  createdAt DateTime @default(now())

  parent   MediaFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children MediaFolder[] @relation("FolderTree")
  assets   MediaAsset[]

  @@index([parentId])
}

model MediaAsset {
  id        String    @id @default(cuid())
  url       String
  key       String    @unique
  type      MediaType @default(IMAGE)
  filename  String
  mimeType  String
  sizeBytes Int
  width     Int?
  height    Int?
  alt       String?
  folderId  String?
  createdAt DateTime  @default(now())

  folder         MediaFolder?          @relation(fields: [folderId], references: [id], onDelete: SetNull)
  productImages  ProductImage[]
  variantImages  ProductVariantImage[]
  certifications Certification[]
  posts          Post[]

  @@index([folderId])
  @@index([type])
}

/// Per-route SEO overrides managed from the admin panel. `path` is the public
/// URL the metadata applies to, e.g. "/disposal/services".
model SeoMeta {
  id             String   @id @default(cuid())
  path           String   @unique
  title          String?
  description    String?  @db.Text
  ogImageUrl     String?
  canonicalUrl   String?
  noIndex        Boolean  @default(false)
  structuredData Json?
  updatedAt      DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Disposal CMS
// ---------------------------------------------------------------------------

/// Free-form editable page sections (hero copy, CTA blocks), keyed by a stable
/// identifier the page reads, e.g. "disposal.hero". Content is JSON so a
/// section's fields can evolve without a migration.
model PageSection {
  id        String   @id @default(cuid())
  key       String   @unique
  division  Division
  content   Json
  updatedAt DateTime @updatedAt

  @@index([division])
}

model DisposalService {
  id        String        @id @default(cuid())
  slug      String        @unique
  title     String
  summary   String        @db.Text
  body      String?       @db.Text
  icon      String
  position  Int           @default(0)
  status    PublishStatus @default(PUBLISHED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, position])
}

model ProcessStep {
  id          String   @id @default(cuid())
  step        Int      @unique
  title       String
  description String   @db.Text
  updatedAt   DateTime @updatedAt
}

model Industry {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String? @db.Text
  icon        String?
  position    Int     @default(0)
}

model Certification {
  id          String  @id @default(cuid())
  name        String
  issuer      String?
  description String? @db.Text
  logoId      String?
  position    Int     @default(0)

  logo MediaAsset? @relation(fields: [logoId], references: [id], onDelete: SetNull)

  @@index([logoId])
}

model Testimonial {
  id        String        @id @default(cuid())
  division  Division
  quote     String        @db.Text
  author    String
  role      String?
  company   String?
  rating    Int?
  avatarUrl String?
  featured  Boolean       @default(false)
  status    PublishStatus @default(PUBLISHED)
  position  Int           @default(0)

  @@index([division, status])
}

model Faq {
  id       String        @id @default(cuid())
  division Division
  question String
  answer   String        @db.Text
  category String?
  position Int           @default(0)
  status   PublishStatus @default(PUBLISHED)

  @@index([division, status, position])
}

enum SubmissionStatus {
  NEW
  IN_PROGRESS
  CLOSED
}

model ContactSubmission {
  id        String           @id @default(cuid())
  division  Division         @default(DISPOSAL)
  name      String
  email     String
  phone     String?
  company   String?
  /// Which CTA produced the enquiry, e.g. "pickup" or "consultation".
  topic     String?
  message   String           @db.Text
  status    SubmissionStatus @default(NEW)
  createdAt DateTime         @default(now())

  notificationSentAt DateTime?

  @@index([status, createdAt])
  @@index([email, createdAt])
}

// ---------------------------------------------------------------------------
// Refurbished store catalog
// ---------------------------------------------------------------------------

enum ProductCondition {
  GRADE_A
  GRADE_B
  GRADE_C
  OPEN_BOX
}

model Brand {
  id       String  @id @default(cuid())
  slug     String  @unique
  name     String
  logoUrl  String?
  position Int     @default(0)

  products Product[]
}

model Category {
  id           String  @id @default(cuid())
  slug         String  @unique
  name         String
  description  String? @db.Text
  imageUrl     String?
  bannerUrl    String?
  thumbnailUrl String?
  iconUrl      String?
  parentId     String?
  position     Int     @default(0)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
}

model Product {
  id   String @id @default(cuid())
  slug String @unique
  name String
  sku  String @unique

  /// Money is stored in minor units (cents) as Int rather than Decimal.
  /// Prisma's Decimal is a class instance, which cannot be passed from a
  /// Server Component to a Client Component without a serialization error —
  /// and Int sidesteps floating-point rounding entirely.
  priceCents     Int
  compareAtCents Int?

  condition        ProductCondition @default(GRADE_A)
  conditionNotes   String?          @db.Text
  warrantyMonths   Int              @default(12)
  shortDescription String?          @db.Text
  description      String?          @db.Text
  stock            Int              @default(0)
  featured         Boolean          @default(false)
  bestSeller       Boolean          @default(false)
  status           PublishStatus    @default(DRAFT)

  /// Denormalised review aggregates. Recomputing these per request would mean
  /// an aggregate query per product on every listing page; they are updated
  /// whenever a review is written.
  ratingAvg   Float @default(0)
  ratingCount Int   @default(0)

  brandId    String?
  categoryId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand            Brand?            @relation(fields: [brandId], references: [id], onDelete: SetNull)
  category         Category          @relation(fields: [categoryId], references: [id])
  images           ProductImage[]
  specs            ProductSpec[]
  reviews          Review[]
  orderItems       OrderItem[]
  wishlistItems    WishlistItem[]
  recentlyViewed   RecentlyViewed[]
  options          ProductOption[]
  variants         ProductVariant[]
  stockMovements   StockMovement[]
  exchangeRequests ExchangeRequest[]

  @@index([categoryId, status])
  @@index([brandId])
  @@index([featured, status])
  @@index([bestSeller, status])
  @@index([priceCents])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id        String       @id @default(cuid())
  productId String
  userId    String?
  author    String
  rating    Int
  title     String?
  body      String       @db.Text
  /// Set when the reviewer's order for this product is confirmed.
  verified  Boolean      @default(false)
  /// Moderation state. New submissions default to PENDING; only APPROVED
  /// reviews are shown on the storefront. (Rows that predate this column are
  /// backfilled to APPROVED by the migration so nothing disappears.)
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@index([status])
}

/// Append-only audit trail of on-hand stock changes, so an admin can see who
/// adjusted what and when. `delta` is signed (positive = restock).
model StockMovement {
  id        String   @id @default(cuid())
  productId String
  delta     Int
  /// Resulting on-hand quantity after this movement, for a running ledger.
  balance   Int
  reason    String
  note      String?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  assetId   String?
  url       String
  alt       String?
  position  Int     @default(0)

  product Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  asset   MediaAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([productId, position])
  @@index([assetId])
}

model ProductSpec {
  id        String  @id @default(cuid())
  productId String
  /// Grouping label, e.g. "Processor" or "Memory".
  group     String?
  name      String
  value     String
  position  Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
}

// ---------------------------------------------------------------------------
// Commerce (no payment processing — checkout stops at order review)
// ---------------------------------------------------------------------------

enum AddressType {
  SHIPPING
  BILLING
}

model Address {
  id         String      @id @default(cuid())
  userId     String
  type       AddressType @default(SHIPPING)
  fullName   String
  phone      String?
  line1      String
  line2      String?
  city       String
  region     String
  postalCode String
  country    String      @default("Germany")
  isDefault  Boolean     @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  userId      String?
  email       String
  status      OrderStatus @default(PENDING)

  subtotalCents Int
  shippingCents Int @default(0)
  taxCents      Int @default(0)
  totalCents    Int

  /// Addresses are snapshotted as JSON so historical orders are unaffected by
  /// later edits to the customer's saved addresses.
  shippingAddress Json
  billingAddress  Json?
  notes           String? @db.Text

  paymentMethod       String?
  paymentStatus       String?   @default("UNPAID")
  paypalOrderId       String?   @unique
  paypalTransactionId String?   @unique
  paidAt              DateTime?
  currency            String    @default("EUR")
  payment             Payment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Set once the confirmation email is accepted by Gmail. Presence of a
  /// timestamp is what makes the send idempotent across retries and refreshes.
  confirmationEmailSentAt DateTime?

  user  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items OrderItem[]

  exchangeCreditCents Int?             @default(0)
  exchangeRequestId   String?          @unique
  exchangeRequest     ExchangeRequest? @relation(fields: [exchangeRequestId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status, createdAt])
}

model Payment {
  id                  String   @id @default(cuid())
  orderId             String   @unique
  paypalOrderId       String   @unique
  paypalCaptureId     String?  @unique
  paypalTransactionId String?  @unique
  payerEmail          String?
  payerName           String?
  amountCents         Int
  currency            String   @default("EUR")
  paymentMethod       String   @default("PayPal")
  status              String // e.g. "COMPLETED"
  createdAt           DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  productId       String?
  variantId       String?
  variantSnapshot Json?

  /// Name, SKU and price are snapshotted at purchase time — the product may
  /// later be renamed, repriced or deleted.
  name       String
  sku        String
  priceCents Int
  quantity   Int    @default(1)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

model RecentlyViewed {
  id        String   @id @default(cuid())
  userId    String
  productId String
  viewedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, viewedAt])
}

enum DiscountType {
  PERCENT
  FIXED
}

/// Modelled for the admin panel; the cart applies coupons in the UI only until
/// payments are integrated.
model Coupon {
  id              String       @id @default(cuid())
  code            String       @unique
  type            DiscountType @default(PERCENT)
  value           Int
  minSpendCents   Int?
  active          Boolean      @default(true)
  expiresAt       DateTime?
  /// Redemption cap across all customers (null = unlimited) and the running
  /// count. `oncePerCustomer` limits a code to one use per customer email.
  usageLimit      Int?
  usageCount      Int          @default(0)
  oncePerCustomer Boolean      @default(false)
  /// One-time redemption ledger (customer emails). Kept as a scalar list
  /// rather than a join table since it is only ever read/appended wholesale.
  redeemedBy      String[]     @default([])
  /// Optional scoping: when non-empty, the coupon only applies to carts that
  /// contain at least one matching product / category. Empty = whole cart.
  productIds      String[]     @default([])
  categoryIds     String[]     @default([])
  createdAt       DateTime     @default(now())
}

// ---------------------------------------------------------------------------
// Blog CMS
// ---------------------------------------------------------------------------

model BlogCategory {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String? @db.Text

  posts Post[]
}

model Tag {
  id   String @id @default(cuid())
  slug String @unique
  name String

  posts Post[]
}

model Post {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  excerpt     String?       @db.Text
  content     String        @db.Text
  status      PublishStatus @default(DRAFT)
  publishedAt DateTime?

  coverImageId String?
  authorId     String?
  categoryId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coverImage MediaAsset?   @relation(fields: [coverImageId], references: [id], onDelete: SetNull)
  author     User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  category   BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags       Tag[]

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([authorId])
  @@index([coverImageId])
}

// ---------------------------------------------------------------------------
// Shopify-Style Product Variants System
// ---------------------------------------------------------------------------

model ProductOption {
  id        String   @id @default(cuid())
  productId String
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@unique([productId, name])
  @@index([productId, position])
}

model ProductOptionValue {
  id       String @id @default(cuid())
  optionId String
  value    String
  position Int    @default(0)

  option                     ProductOption               @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variantOptionValueMappings ProductVariantOptionValue[]

  @@unique([optionId, value])
  @@index([optionId, position])
}

model ProductVariant {
  id             String            @id @default(cuid())
  productId      String
  sku            String            @unique
  barcode        String?
  priceCents     Int
  compareAtCents Int?
  stock          Int               @default(0)
  condition      ProductCondition?
  conditionNotes String?           @db.Text
  warrantyMonths Int?
  weightGrams    Int?
  dimensions     String?
  status         PublishStatus     @default(PUBLISHED)
  position       Int               @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product      Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues ProductVariantOptionValue[]
  images       ProductVariantImage[]
  orderItems   OrderItem[]

  @@index([productId, status])
  @@index([sku])
  @@index([priceCents])
}

model ProductVariantOptionValue {
  id            String @id @default(cuid())
  variantId     String
  optionValueId String

  variant     ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@unique([variantId, optionValueId])
  @@index([variantId])
  @@index([optionValueId])
}

model ProductVariantImage {
  id        String  @id @default(cuid())
  variantId String
  assetId   String?
  url       String
  alt       String?
  position  Int     @default(0)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  asset   MediaAsset?    @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([variantId, position])
  @@index([assetId])
}

model ExchangeRequest {
  id               String   @id @default(cuid())
  referenceNumber  String   @unique
  userId           String?
  productId        String? // The product they purchase, if linked
  deviceType       String // Laptop, Desktop, etc.
  brand            String // Dell, Apple, etc.
  model            String
  customModel      Boolean  @default(false)
  configRam        String
  configStorage    String
  configCpu        String
  configGpu        String?
  configGeneration String?
  serialNumber     String?
  serviceTag       String?
  purchaseYear     Int?
  condition        String // Excellent, Good, Fair, Damaged, Non Working
  checklist        Json // checklist results as json
  images           String[] // front, back, etc.
  description      String?  @db.Text

  // How to reach the customer. Collected in the wizard so guest submissions
  // are actionable — before this existed only logged-in requests could be
  // followed up on.
  contactName  String?
  contactEmail String?
  contactPhone String?

  /// Legacy automatic valuation. The customer-facing flow no longer produces
  /// one (Rhydm prices every device by hand), so new rows are 0; historical
  /// rows keep their value for admin reference only and are never shown to
  /// the customer.
  estimatedValueCents Int @default(0)

  // ---- Manual offer, entered by an admin after reviewing device + photos ----
  finalValueCents     Int? // the offer amount
  offerMethod         String? // WhatsApp, Email, Phone, Other
  offerNotes          String?   @db.Text
  offerSentAt         DateTime?
  customerContactedAt DateTime?

  status         String // PENDING(=New), UNDER_REVIEW, INFO_REQUIRED, OFFER_SENT, APPROVED(=Customer Accepted), REJECTED(=Customer Declined), PICKUP_SCHEDULED, RECEIVED, INSPECTION, COMPLETED, CANCELLED
  notes          String?  @db.Text // internal admin notes — never exposed to the customer
  pickupOption   String? // Pickup, Drop-off, Courier
  pickupSchedule Json? // date, time, address
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user       User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  product    Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  order      Order?
  activities ExchangeActivity[]

  @@index([userId])
  @@index([status])
  @@index([referenceNumber])
}

model ExchangeActivity {
  id                String   @id @default(cuid())
  exchangeRequestId String
  userId            String?
  action            String // e.g. "REQUEST_CREATED", "STATUS_UPDATED", "COUNTER_OFFER_MADE", "IMAGES_UPLOADED", "PICKUP_SCHEDULED", etc.
  fromStatus        String?
  toStatus          String?
  details           String?  @db.Text
  createdAt         DateTime @default(now())

  exchangeRequest ExchangeRequest @relation(fields: [exchangeRequestId], references: [id], onDelete: Cascade)
  user            User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([exchangeRequestId])
}

// ---------------------------------------------------------------------------
// Email system
//
// Outbound mail goes through a single Gmail API transport (lib/email). These
// models cover three concerns: an audit trail of every send, opt-in state for
// marketing, and campaign bookkeeping so a large send can be batched and
// resumed rather than run inside one HTTP request.
// ---------------------------------------------------------------------------

enum EmailType {
  ORDER_CONFIRMATION
  PASSWORD_RESET
  EXCHANGE_RECEIVED
  EXCHANGE_ADMIN_NOTIFICATION
  CONTACT_NOTIFICATION
  CONTACT_ACKNOWLEDGEMENT
  ADMIN_NOTIFICATION
  MARKETING
  TEST
}

enum EmailStatus {
  QUEUED
  /// Claimed by a worker and in flight. Prevents a second worker double-sending.
  SENDING
  SENT
  FAILED
  /// Terminal: the address is invalid, so retrying can never succeed.
  BOUNCED
}

/// One row per send attempt. Deliberately stores no credentials and no message
/// body — only what is needed to answer "did this person get this email?".
model EmailLog {
  id        String      @id @default(cuid())
  recipient String
  type      EmailType
  subject   String
  status    EmailStatus @default(QUEUED)
  /// Provider-side message id, useful when tracing a delivery complaint.
  messageId String?
  error     String?     @db.Text
  attempts  Int         @default(0)

  userId     String?
  orderId    String?
  campaignId String?

  createdAt DateTime  @default(now())
  sentAt    DateTime?

  campaign EmailCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([recipient])
  @@index([type, status])
  @@index([orderId])
  @@index([campaignId])
  @@index([createdAt])
}

enum CampaignStatus {
  DRAFT
  QUEUED
  SENDING
  SENT
  PARTIAL
  FAILED
  CANCELLED
}

enum CampaignAudience {
  ALL_OPTED_IN
  NEWSLETTER_SUBSCRIBERS
  CUSTOMERS_WITH_ORDERS
}

model EmailCampaign {
  id          String           @id @default(cuid())
  name        String
  subject     String
  /// Inbox preview line. Rendered as hidden preheader text.
  previewText String?
  /// Admin-authored HTML. Sanitised on save and again before send.
  bodyHtml    String           @db.Text
  /// Plain-text alternative, derived from bodyHtml when the admin leaves it blank.
  bodyText    String?          @db.Text
  audience    CampaignAudience @default(ALL_OPTED_IN)
  /// Product ids featured as cards beneath the body copy.
  productIds  String[]         @default([])
  status      CampaignStatus   @default(DRAFT)

  totalRecipients Int @default(0)
  sentCount       Int @default(0)
  failedCount     Int @default(0)

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  recipients CampaignRecipient[]
  emailLogs  EmailLog[]

  @@index([status, createdAt])
}

/// Materialised recipient list. Snapshotting the audience at queue time means a
/// resumed or retried send targets exactly who it was meant to, and gives an
/// exactly-once guarantee per address via the unique constraint.
model CampaignRecipient {
  id         String      @id @default(cuid())
  campaignId String
  email      String
  name       String?
  userId     String?
  status     EmailStatus @default(QUEUED)
  error      String?     @db.Text
  attempts   Int         @default(0)
  sentAt     DateTime?
  /// When a worker claimed this row. A claim older than the stale window is
  /// reclaimed, so a crash mid-send cannot strand a recipient in SENDING.
  claimedAt  DateTime?

  campaign EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, email])
  @@index([campaignId, status])
}

/// Marketing opt-in for people who are not registered users.
model NewsletterSubscriber {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String?
  consent          Boolean   @default(true)
  /// Opaque token for one-click unsubscribe without a login.
  unsubscribeToken String    @unique
  source           String?
  createdAt        DateTime  @default(now())
  unsubscribedAt   DateTime?

  @@index([consent])
}

/// Encrypted storage for the Gmail refresh token.
///
/// The OAuth connect flow has to put the token *somewhere* between Google
/// issuing it and the mailbox being usable. A redirect URL would leak it into
/// browser history, the Referer header and every access log in the path, so it
/// is sealed with AES-256-GCM and written here instead. The environment
/// variable still wins when set, keeping a pure 12-factor deployment possible.
model EmailCredential {
  /// Single-row table; always "gmail".
  id String @id

  /// AES-256-GCM payload. Never a plaintext token.
  ciphertext String @db.Text
  iv         String
  authTag    String

  /// Which mailbox this was issued for, so a changed GOOGLE_EMAIL invalidates it.
  senderEmail String
  scope       String?

  connectedById String?
  connectedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
