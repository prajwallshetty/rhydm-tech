# Copy to .env and fill in. Never commit the real .env.

# Postgres connection string.
# Local development: run `npx prisma dev` and paste the URL it prints.
# Production: use your hosted Postgres (Neon, Supabase, RDS, ...).
DATABASE_URL="postgresql://user:password@localhost:5432/rhydm?schema=public"

# Only needed for `prisma migrate dev`, which creates a temporary shadow
# database to detect schema drift. Not required in production.
SHADOW_DATABASE_URL=""

# Public origin, used for canonical URLs, sitemap.xml, robots.txt, OG tags,
# the OAuth redirect URIs, and every link inside an outbound email.
# MUST be the real production origin in production — emails outlive deploys, so
# a preview URL here bakes a dead link into a customer's inbox permanently.
NEXT_PUBLIC_SITE_URL="https://rhydm-tech.com"

# Cloudinary media library (admin uploads). Create a free account at
# cloudinary.com → Dashboard shows all three values. Uploads are signed
# server-side; the secret is never sent to the browser.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---------------------------------------------------------------------------
# Google OAuth
#
# TWO SEPARATE FEATURES share these credentials. They are different things:
#
#   1. "Sign in with Google" on the storefront (lib/auth/google.ts)
#      Scopes: userinfo.profile, userinfo.email
#      Redirect URI: https://rhydm-tech.com/api/auth/google/callback
#
#   2. Sending email as the company (lib/email/)
#      Scope:  https://www.googleapis.com/auth/gmail.send
#      Redirect URI: https://rhydm-tech.com/api/email/google/callback
#
# One Google Cloud OAuth client can serve both — add BOTH redirect URIs to it.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# The mailbox all outbound mail is sent from. Appears in every From: header.
# Must be the Google account you authorise at Admin -> Settings -> Email.
GOOGLE_EMAIL="website@rhydm-tech.com"

# Long-lived Gmail sending credential.
#
# Optional. Leave blank and connect the mailbox from Admin -> Settings -> Email
# instead: the token is then sealed with AES-256-GCM and kept in the
# EmailCredential table. Set it here and it takes precedence over the stored
# copy, which is the right choice for a 12-factor deploy.
#
# NEVER commit a real value. NEVER prefix it with NEXT_PUBLIC_.
GOOGLE_REFRESH_TOKEN=""

# Where admin notifications go: new orders, trade-in requests, contact enquiries.
# Falls back to GOOGLE_EMAIL if unset, but should be set explicitly.
ADMIN_EMAIL="hello@rhydm-tech.com"

# Display name on outbound mail. Defaults to "Rhydm Technologies".
EMAIL_FROM_NAME="Rhydm Technologies"

# Signs sessions AND derives the key that encrypts the stored Gmail refresh
# token. Rotating it invalidates both: users are signed out and the mailbox
# must be reconnected. Use a long random string.
AUTH_SECRET=""
